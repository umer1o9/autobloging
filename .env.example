# Local development only. Production deployment needs the hardening in README.md.
HOST=127.0.0.1
PORT=3210
# Set cron when hPanel cron runs npm run worker:once; otherwise use embedded.
WORKER_MODE=embedded
# Optional persistent absolute path shared by the web app and cron worker.
# Set outside hbuilds/current on Hostinger so images survive redeployment.
MEDIA_DIRECTORY=
APP_ORIGIN=http://127.0.0.1:3210
DATABASE_URL=mysql://autoblog:CHANGE_ME@127.0.0.1:3307/autoblog
# Tests create and drop unique databases prefixed abtest; use a separate test account.
TEST_DATABASE_URL=mysql://autoblog_test:CHANGE_ME@127.0.0.1:3307/abtest
# Set true with a managed MySQL server that supports trusted TLS.
MYSQL_SSL=false
# Optional live Gemini generation. Choose model IDs available to your account.
# Paid calls run after Generate or Start automation; the API key and opt-in are required.
GEMINI_API_KEY=
GEMINI_RESEARCH_MODEL=gemini-3.5-flash-lite
GEMINI_WRITER_MODEL=gemini-3.5-flash-lite
# Used only when the economical first draft fails deterministic validation.
GEMINI_REPAIR_MODEL=gemini-3.8-flash
# Optional article image generation. Configure either or both providers.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Explicitly acknowledge that reservations are admission controls, not provider billing caps.
ALLOW_PAID_GENERATION=false
